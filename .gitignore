# See https://dart.dev/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.packages
build/
# The workspace resolves from a single lockfile at the repo root; it is not
# checked in because every package here is a library.
pubspec.lock

# Directory created by dartdoc
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# Node toolchain used only to generate/verify fixtures against upstream Lexical.
node_modules/
package-lock.json

# Flutter golden-test output
**/failures/

# IDE project files generated by `flutter create`
*.iml

# macOS
.DS_Store
